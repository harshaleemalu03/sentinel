# Server
PORT=4003

# Where Module 2 (Incident Intelligence / Truth Engine) lives.
# We POST action results back here so the Truth Engine can update IncidentState.
TRUTH_ENGINE_BASE_URL=http://localhost:4002

# Where Module 4 (Dashboard) listens for our WebSocket action/approval events.
# If the dashboard connects directly to OUR /ws endpoint instead, leave this blank.
DASHBOARD_WEBHOOK_URL=

# Slack incoming webhook (real). Create one at https://api.slack.com/apps > Incoming Webhooks
SLACK_WEBHOOK_URL=

# Jira (mocked by default - see src/services/jiraIntegration.js).
# Fill these in only if you flip USE_REAL_JIRA=true
USE_REAL_JIRA=false
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# PagerDuty (mocked by default - see src/services/pagerdutyIntegration.js)
USE_REAL_PAGERDUTY=false
PAGERDUTY_ROUTING_KEY=

# Simple shared secret so Module 2 can call our /results-ack or /actions endpoints
INTERNAL_API_KEY=change-me
