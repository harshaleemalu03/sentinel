# ==============================================================================
# SENTINEL — ENVIRONMENT CONFIGURATION
# EchoSphere: Agora Conversational AI Hackathon 2026
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT VARIABLES (Exposed to browser client bundle)
# ------------------------------------------------------------------------------
# Agora App ID from Agora Console (https://console.agora.io)
NEXT_PUBLIC_AGORA_APP_ID=your_agora_app_id_here

# Optional UID assigned to Sentinel AI Agent in the RTC channel (default: 123456)
NEXT_PUBLIC_AGENT_UID=123456

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (Protected on server, never exposed in client bundle)
# ------------------------------------------------------------------------------
# Agora App Certificate from Agora Console (used for secure RTC/RTM token generation)
NEXT_AGORA_APP_CERTIFICATE=your_agora_app_certificate_here

# OpenAI API Key for TruthEngine LLM extraction and agent dialogue turns
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Override OpenAI model (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: External Python FastAPI Incident Intelligence URL
# If left blank, Sentinel uses its embedded high-performance Truth Engine natively
# SENTINEL_INTELLIGENCE_URL=http://localhost:8000
