{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "experimentalServices": {
    "frontend": {
      "entrypoint": "incident-dashboard",
      "routePrefix": "/"
    },
    "backend": {
      "entrypoint": "incident-intelligence",
      "framework": "fastapi",
      "routePrefix": "/api"
    },
    "agora": {
      "entrypoint": "agora-voice",
      "framework": "nextjs",
      "routePrefix": "/voice"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/voice/(.*)",
      "destination": {
        "service": "agora"
      }
    },
    {
      "source": "/voice",
      "destination": {
        "service": "agora"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
